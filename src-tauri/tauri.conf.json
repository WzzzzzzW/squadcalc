{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SquadCalc",
  "version": "46.1.0",
  "identifier": "com.squadcalc.app",
  "build": {
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "SquadCalc · 战术小队助手",
        "width": 1760,
        "height": 1000,
        "minWidth": 1360,
        "minHeight": 820,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": { "enable": true, "scope": ["**"] }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
